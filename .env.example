# Optional. Defaults to the current calendar year.
# ESPN_SEASON=2026

# Optional fallback if league auto-discovery (ESPN fan API) fails or misses a league.
# Comma-separated ESPN league IDs.
# LEAGUE_IDS=12345678,87654321

# Optional. Where the Playwright login profile lives (defaults to %TEMP%/fantasy-viewer-profile).
# ESPN_PROFILE_DIR=C:/tmp/fantasy-viewer-profile
